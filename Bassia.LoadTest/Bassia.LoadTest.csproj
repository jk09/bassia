<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>bassia-loadtest</AssemblyName>
    <RootNamespace>Bassia.LoadTest</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bassia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bassia.Core\Bassia.Core.csproj" />
    <ProjectReference Include="..\Bassia\Bassia.csproj" />
    <ProjectReference Include="..\Bassia.Server\Bassia.Server.csproj" />
  </ItemGroup>

</Project>
