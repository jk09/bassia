<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bassia.Tests" />
    <InternalsVisibleTo Include="bassia-server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bassia.Core\Bassia.Core.csproj" />
  </ItemGroup>

  <!-- No ASP.NET Core code is left in the CLI, but Bassia.dll is also started from Studio's (and the tests') folders, where
       Microsoft.Extensions.* (Npgsql's and Azure's dependencies) come from the ASP.NET Core shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.7" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="Tomlyn.Signed" Version="2.10.1" />
  </ItemGroup>

</Project>
