@page "/workspaces"
@inherits StudioPage

<PageTitle>Workspaces · Bassia Studio</PageTitle>
<h1>Workspaces</h1>
<p class="muted">Each agentic run works in its own workspace over the monorepo; a workspace lands on mainline as one change.</p>
<div class="diffbar">
	<a class="@(All ? "" : "on")" href="/workspaces">Open</a>
	<a class="@(All ? "on" : "")" href="/workspaces?all=true">All</a>
	<span class="spacer"></span>
	<a href="/workspaces/new">New workspace</a>
</div>
<ErrorNotice Message="@Error" />
@if (workspaces.Count == 0 && Error is null)
{
	<p class="notice">No @(All ? "" : "open ")workspace.</p>
}
else
{
	<table class="list">
		<tr><th>Name</th><th>Status</th><th>Owner</th><th>Base</th><th>Stacked on</th><th>Run</th><th>Created</th></tr>
		@foreach (var state in workspaces)
		{
			var record = state.Record;
			<tr>
				<td class="id"><a href="/workspaces/@Format.Q(state.Id)">@state.Name</a></td>
				<td><span class="st st-@record.Status">@record.Status</span></td>
				<td>@record.Owner</td>
				<td><a href="/log/@record.BaseSeq">seq @record.BaseSeq</a></td>
				<td class="id">@(record.Parent ?? "mainline")</td>
				<td>@(record.Run is { } run ? $"{run.Status} ({run.Agent})" : "")</td>
				<td>@Format.Time(record.Created)</td>
			</tr>
		}
	</table>
	@if (older is { } next)
	{
		<p class="muted">The newest @Repository.ClosedPage closed workspaces@(Before is null ? "" : " before this page"). <a href="/workspaces?all=true&before=@next">Older</a></p>
	}
}

@code {
	[SupplyParameterFromQuery(Name = "all")] public bool All { get; set; }

	/// <summary>Closed workspaces created before this time (UTC ticks): the next page of "All".</summary>
	[SupplyParameterFromQuery(Name = "before")] public long? Before { get; set; }

	private IReadOnlyList<WorkspaceState> workspaces = [];
	private long? older;

	protected override bool LiveUpdates => true;

	protected override async Task LoadAsync()
	{
		var repo = await Client.OpenAsync();
		var before = Before is { } ticks ? new DateTimeOffset(ticks, TimeSpan.Zero) : (DateTimeOffset?)null;
		workspaces = (await repo.ListWorkspacesAsync(All, closedBefore: before)).OrderByDescending(state => state.Record.Created).ToList();

		// Closed workspaces come a page at a time, newest first; the link below continues before the oldest one shown.
		var closed = workspaces.Where(state => !state.IsOpen).ToList();
		older = All && closed.Count >= Repository.ClosedPage ? closed[^1].Record.Created.UtcTicks : null;
	}
}
