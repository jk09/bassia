@page "/"
@inherits StudioPage

<PageTitle>Bassia Studio</PageTitle>
<h1>Overview</h1>
<ErrorNotice Message="@Error" />
@if (main is not null)
{
	<div class="cards">
		<div class="card"><div class="big">@main.Seq</div><div class="muted">mainline seq</div></div>
		<div class="card"><div class="big">@open</div><div class="muted">open workspaces</div></div>
		<div class="card"><div class="big">@Format.Time(main.Commit.Time)</div><div class="muted">last landing</div></div>
	</div>
	<h2>Recent landings</h2>
	<LogTable Entries="recent" />
	<p><a href="/log">Full log</a> · <a href="/depot">Browse the depot</a> · <a href="/workspaces">Workspaces</a></p>
}

@code {
	private MainState? main;
	private int open;
	private IReadOnlyList<LogEntry> recent = [];

	protected override bool LiveUpdates => true;

	protected override async Task LoadAsync()
	{
		var repo = await Client.OpenAsync();
		main = await repo.GetMainAsync();
		open = (await repo.ListWorkspacesAsync()).Count;
		recent = await Client.LogAsync(null, 10);
	}
}
