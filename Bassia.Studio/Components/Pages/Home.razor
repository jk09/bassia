@page "/"
@inherits StudioPage

<PageTitle>Bassia Studio</PageTitle>
<h1>Overview</h1>
<ErrorNotice Message="@Error" />
@if (loaded)
{
	<div class="cards">
		<div class="card"><div class="big">@open</div><div class="muted">open workspaces</div></div>
	</div>
	<h2>Recent landings</h2>
	<LogTable Entries="recent" />
}

@code {
	private bool loaded;
	private int open;
	private IReadOnlyList<LogEntry> recent = [];

	protected override bool LiveUpdates => true;

	protected override async Task LoadAsync()
	{
		var repo = await Client.OpenAsync();
		open = (await repo.ListWorkspacesAsync()).Count;
		recent = await Client.LogAsync(null, 10);
		loaded = true;
	}
}
