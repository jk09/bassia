<Project Sdk="Microsoft.NET.Sdk">

  <!-- A deterministic stand-in for Claude Code in the agent scenarios: started as 'agent.command' with the prompt as its
       last argument, it carries out the few instructions the scenarios give in plain English. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bassia-standin-agent</AssemblyName>
    <RootNamespace>Bassia.Scenarios.Agent</RootNamespace>
  </PropertyGroup>

</Project>
