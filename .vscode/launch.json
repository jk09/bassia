{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Bassia: Debug with args",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-bassia",
            "program": "${workspaceFolder}/Bassia/bin/Debug/net10.0/Bassia.dll",
            "args": "${input:bassiaArgs}",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ],
    "inputs": [
        {
            "id": "bassiaArgs",
            "type": "promptString",
            "description": "Arguments to pass to Bassia (space-separated, e.g. init C:\\path\\to\\dir)",
            "default": ""
        }
    ]
}
